<receipt paper-width="32">
  {{#fiscal.is_report_document}}
  <align mode="center"><bold><text>{{report.title}}</text></bold>
    {{#report.subtitle}}<text>{{report.subtitle}}</text>{{/report.subtitle}}
    <text>{{store.name}}</text><text>{{report.scope.label}}</text>
  </align>
  {{#report.is_partial}}<bold><text>{{report.partial_reason}}</text></bold>{{/report.is_partial}}
  <line />
  {{#report.has_groups}}{{#report.groups}}
  <line /><align mode="center"><bold><text>{{label}}</text></bold></align>
  {{#rows}}<bold><text>{{label}}</text></bold>{{#cells}}{{^is_first}}<row><col width="*">{{label}}</col><col width="*" align="right">{{formatted}}</col></row>{{/is_first}}{{/cells}}{{/rows}}
  <bold><text>{{i18n.subtotal}}</text></bold>{{#subtotal}}{{#cells}}{{^is_first}}<row><col width="*">{{label}}</col><col width="*" align="right">{{formatted}}</col></row>{{/is_first}}{{/cells}}{{/subtotal}}
  {{/report.groups}}{{/report.has_groups}}
  {{^report.has_groups}}{{#report.rows}}<bold><text>{{label}}</text></bold>{{#cells}}{{^is_first}}<row><col width="*">{{label}}</col><col width="*" align="right">{{formatted}}</col></row>{{/is_first}}{{/cells}}{{/report.rows}}{{/report.has_groups}}
  <line /><bold><text>{{i18n.total}}</text></bold>{{#report.totals}}{{#cells}}{{^is_first}}<row><col width="*">{{label}}</col><col width="*" align="right">{{formatted}}</col></row>{{/is_first}}{{/cells}}{{/report.totals}}
  <text>{{report.generated_at.datetime}}</text>
  <align mode="center"><text>{{software.name}} {{software.plugin_version}}</text></align>
  <feed lines="3" /><cut />
  {{/fiscal.is_report_document}}
</receipt>
