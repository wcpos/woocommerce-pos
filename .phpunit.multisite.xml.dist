<?xml version="1.0"?>
<!-- Runs only @group multisite under a WordPress network install; see tests/includes/API/V2/Test_Auth_Sessions_Scope_Multisite.php -->
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	>
	<php>
		<const name="WP_TESTS_MULTISITE" value="1" />
	</php>
	<extensions>
		<extension class="WCPOS\WooCommercePOS\Tests\Helpers\Save_Reentry_Guard_Reset" file="tests/Helpers/Save_Reentry_Guard_Reset.php" />
	</extensions>
	<testsuites>
		<testsuite name="multisite">
			<directory prefix="test-" suffix=".php">./tests/</directory>
			<directory prefix="Test_" suffix=".php">./tests/</directory>
			<directory suffix="_Test.php">./tests/</directory>
		</testsuite>
	</testsuites>
	<groups>
		<include>
			<group>multisite</group>
		</include>
	</groups>
</phpunit>
